{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "lib/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/poll", "dest": "/api/poll.js" },
    { "src": "/api/fleet", "dest": "/api/fleet.js" },
    { "src": "/api/lookup", "dest": "/api/lookup.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
