{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "manifest.webmanifest", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/poll", "dest": "/api/poll.js" },
    { "src": "/api/fleet", "dest": "/api/fleet.js" },
    { "src": "/api/lookup", "dest": "/api/lookup.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/export", "dest": "/api/export.js" },
    { "src": "/manifest.webmanifest", "dest": "/manifest.webmanifest" },
    { "src": "/sw.js", "dest": "/sw.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
